# Life OS — deployment environment
#
# Set these in your host's environment settings (Vercel: Project → Settings →
# Environment Variables → Production). Never commit real values: .env files are
# git-ignored, and none of these are prefixed VITE_, so none reach the browser.
#
# Generate the first two with:   npm run auth:setup
# It prompts for your password without echoing it and prints both values.

# PBKDF2-SHA256 hash of the owner password. Required. Never the password itself.
LIFEOS_PASSWORD_HASH=

# Random signing secret for session cookies, at least 32 characters. Required.
# Changing it (or the password) signs out every device.
LIFEOS_SESSION_SECRET=

# Groq API key for the AI coach. Optional: without it everything else works and
# the coach explains that AI is not configured. Held only on the server; the
# browser never receives it. Create one at https://console.groq.com/keys
GROQ_API_KEY=

# Sync between devices. Optional. Added automatically when you create an Upstash
# Redis database in Vercel → Storage and connect it to this project. Either
# naming works. Without them each device keeps its own separate copy.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# Local development only
# ---------------------------------------------------------------------------
# `npm run dev` runs without sign-in and calls Groq from the browser with a key
# entered in Settings. Optional override for that dev-only path:
# VITE_GROQ_BASE_URL=https://api.groq.com/openai/v1
